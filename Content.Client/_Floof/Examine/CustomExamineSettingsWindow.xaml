<controls:CustomExamineSettingsWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._Floof.Examine"
    xmlns:controls1="clr-namespace:Content.Client.UserInterface.Controls"
    MinSize="650 200"
    Title="{Loc 'custom-exam-title'}">

    <SplitContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True">
        <!-- Left side -->
        <BoxContainer Orientation="Vertical" Margin="5" HorizontalExpand="True" VerticalExpand="True">
            <!-- Guidelines -->
            <Collapsible>
                <CollapsibleHeading Title="{Loc 'custom-exam-guidelines-heading'}"/>
                <CollapsibleBody>
                    <ScrollContainer SetHeight="140" HScrollEnabled="False">
                        <!-- I hate how I have to limit the size of this label here, but it doesn't seem I can stop it from expanding otherwise. -->
                        <RichTextLabel
                            Text="{Loc 'custom-exam-guidelines'}"
                            Margin="5"
                            MaxWidth="500"/>
                    </ScrollContainer>
                </CollapsibleBody>
            </Collapsible>

            <!-- Main body -->
            <BoxContainer Orientation="Horizontal" VerticalAlignment="Stretch" VerticalExpand="True">
                <controls:CustomExaminePart
                    Name="Public"
                    Title="{Loc 'custom-exam-public-title'}"
                    VerticalExpand="True"
                    HorizontalAlignment="Stretch"
                    Margin="5"
                    Access="Public"/>

                <controls:CustomExaminePart
                    Name="Subtle"
                    Title="{Loc 'custom-exam-subtle-title'}"
                    VerticalExpand="True"
                    HorizontalAlignment="Stretch"
                    Margin="5"
                    Access="Public"/>
            </BoxContainer>

            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="ResetButton" Text="{Loc 'custom-exam-reset'}" StyleClasses="OpenRight"/>
                <Button Name="SaveButton" Text="{Loc 'custom-exam-save'}" StyleClasses="OpenLeft" />
            </BoxContainer>
        </BoxContainer>

        <!-- Right side - presets -->
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" MinWidth="200">
            <Label Text="{Loc 'custom-exam-preset-header'}"></Label>

            <!-- Main list -->
            <ScrollContainer
                HScrollEnabled="False"
                VScrollEnabled="True"
                HorizontalExpand="True"
                VerticalExpand="True">

                <BoxContainer Orientation="Vertical" Name="PresetList" VerticalExpand="True"/>

            </ScrollContainer>

            <!-- Save panel -->
            <controls1:HLine Color="#404040"  Thickness="2" Margin="0 5" HorizontalExpand="True"/>
            <Label Text="{Loc 'custom-exam-preset-save-header'}"/>

            <BoxContainer Orientation="Horizontal">
                <HistoryLineEdit
                    Name="PresetNameField"
                    PlaceHolder="{Loc 'custom-exam-preset-name-placeholder'}"
                    HorizontalExpand="True"/>

                <TextureButton Name="SavePresetButton" TexturePath="/Textures/Interface/VerbIcons/group.svg.192dpi.png" SetSize="32 32"/>
            </BoxContainer>
        </BoxContainer>
    </SplitContainer>

</controls:CustomExamineSettingsWindow>
