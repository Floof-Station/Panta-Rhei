<DefaultWindow xmlns="https://spacestation14.io"
            xmlns:tabs="clr-namespace:Content.Client.Options.UI.Tabs"
            xmlns:dtabs="clr-namespace:Content.Client._DV.Options.UI.Tabs"
            xmlns:rmc="clr-namespace:Content.Client._RMC14.UserInterface.Options"
            Title="{Loc 'ui-options-title'}"
            MinSize="800 450">
    <TabContainer Name="Tabs" Access="Public">
        <tabs:MiscTab Name="MiscTab" />
        <tabs:GraphicsTab Name="GraphicsTab" />
        <tabs:KeyRebindTab Name="KeyRebindTab" />
        <tabs:AudioTab Name="AudioTab" />
        <tabs:AccessibilityTab Name="AccessibilityTab" />
        <tabs:AdminOptionsTab Name="AdminOptionsTab" />
        <dtabs:RadioTab Name="RadioTab" /> <!-- DeltaV - Client-side Radio Options -->
        <dtabs:DeltaTab Name="DeltaTab" /> <!-- DeltaV -->
        <rmc:VoicelinesTab Name="VoicelinesTab" /> <!-- Euph, RMC14 species sfx muting from Harmony@#963 -->
    </TabContainer>
</DefaultWindow>
