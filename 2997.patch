From 85f44996ea237343afd15764d233793935313d03 Mon Sep 17 00:00:00 2001
From: CrazyPhantom779 <izayussedwards@gmail.com>
Date: Mon, 26 Jan 2026 20:20:51 +1100
Subject: [PATCH 05/15] Allow pipe stacking for most binary devices (#126)

Cherry-picked from carpmosia/carpmosia 8df5aaf248
---
 .../Structures/Piping/Atmospherics/binary.yml  | 18 +++++++++++++++---
 1 file changed, 15 insertions(+), 3 deletions(-)

diff --git a/Resources/Prototypes/Entities/Structures/Piping/Atmospherics/binary.yml b/Resources/Prototypes/Entities/Structures/Piping/Atmospherics/binary.yml
index 65731110b570..74ce00122a31 100644
--- a/Resources/Prototypes/Entities/Structures/Piping/Atmospherics/binary.yml
+++ b/Resources/Prototypes/Entities/Structures/Piping/Atmospherics/binary.yml
@@ -6,9 +6,11 @@
     mode: AlignAtmosPipeLayers # starlight
   components:
   - type: AtmosDevice
-  - type: Tag
-    tags:
-      - Unstackable
+  # Carpmosia-start - Atmos stacking
+  # - type: Tag
+  #   tags:
+  #     - Unstackable
+  # Carpmosia-end - Atmos stacking
   - type: SubFloorHide
     blockInteractions: false
     blockAmbience: false
@@ -463,6 +465,11 @@
   placement:
     mode: AlignAtmosPipeLayers # starlight
   components:
+    # Carpmosia-start - Atmos stacking
+    - type: Tag
+      tags:
+        - Unstackable
+    # Carpmosia-end - Atmos stacking
     - type: SubFloorHide
       visibleLayers:
       - enum.SubfloorLayers.FirstLayer
@@ -686,6 +693,11 @@
   placement:
     mode: SnapgridCenter
   components:
+  # Carpmosia-start - Atmos stacking
+  - type: Tag
+    tags:
+      - Unstackable
+  # Carpmosia-end - Atmos stacking
   - type: Rotatable
   - type: Transform
     noRot: false

